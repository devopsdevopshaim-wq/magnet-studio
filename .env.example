# ─────────────────────────────────────────────────────────────
#  הפנקס היומי — משתני סביבה. העתיקו לקובץ בשם .env והשלימו.
#  כל השורות אופציונליות — המערכת עובדת גם בלי אף אחת מהן.
#  הקובץ .env לא נכנס ל-git (ראו .gitignore). לעולם אל תשתפו אותו.
# ─────────────────────────────────────────────────────────────

# פורט השרת (ברירת מחדל 4420)
PORT=4420

# ── הזדהות (חובה לפריסה ציבורית! בלי זה כל מי שיגיע לכתובת רואה הכל) ──
# הגדירו סיסמה חזקה. כשמוגדרת — כל המערכת מאחורי מסך התחברות.
# בהרצה מקומית (localhost) השאירו ריק — אין צורך בהזדהות.
PNKS_AUTH_PASSWORD=
# אופציונלי: מפתח נוסף לחתימת העוגייה (אחרת נגזר מהסיסמה)
PNKS_AUTH_SECRET=

# ── Maton — Gmail / יומן / Drive במקום אחד (api.maton.ai) ──
# מפתח מ-console של maton.ai. תומך עד 3 מפתחות (חשבונות שונים).
MATON_API_KEY=
MATON_API_KEY_2=
MATON_API_KEY_3=
# תדירות סנכרון מייל/יומן בדקות (ברירת מחדל 6)
LIVE_SYNC_INTERVAL_MIN=6

# ── הקראה בקול נשי (TTS) ──
# אם מוגדר — Microsoft "Hila" Neural (הכי אנושי). אחרת נופל ל-Google Translate TTS בחינם.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_VOICE=he-IL-HilaNeural

# ── מסד הדיור (DiraFinder) ──
# ב-docker-compose זה מוגדר אוטומטית. מקומי בלי דוקר: postgres://dira:dira_local@localhost:5433/dira
HOUSING_DB_URL=
HOUSING_API_BASE=

# ── JARVIS מקומי (n8n) ──
# ב-docker-compose: http://n8n:5678 . מקומי רגיל: http://localhost:5680
JARVIS_LOCAL_BASE=

# ── חיבור הטלפון בסריקה אחת (הגדרות → סעיף 10) ──
# הכתובת הציבורית שאליה ה-QR מפנה את הטלפון (ברירת מחדל: הפריסה ב-Vercel)
PNKS_PUBLIC_BASE=https://dist-web-ochre.vercel.app
# כתובת n8n Cloud ומפתח ה-Header Auth (x-pnks-token) של ה-webhook pnks — נכללים ב-QR
PNKS_CLOUD_BASE=
PNKS_CLOUD_TOKEN=

# ── AI מקומי (Ollama / Open WebUI) לסיכום היומי ולפאנל ה-AI ──
OPENWEBUI_BASE_URL=http://localhost:11434
OPENWEBUI_MODEL=llama3.1
OPENWEBUI_API_KEY=

# ── Outlook מקומי (Windows בלבד) ──
# 1 = לסרוק את תיבת Outlook אוטומטית. השאירו ריק אם אין חשבון Outlook מוגדר.
ENABLE_OUTLOOK_AUTOSCAN=
